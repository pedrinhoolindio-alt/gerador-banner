{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gerador-banner-ai",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-19",
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "FLUX_RATE_LIMIT",
      "namespace_id": "78111920261119",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
